@PACKAGE_INIT@

# find_package(QGCPluginAPI) config for the out-of-tree plugin SDK (U2.7).
# A consuming project never clones QGC; it just does:
#
#   find_package(QGCPluginAPI 2 REQUIRED)
#   target_link_libraries(MyPlugin PRIVATE QGCPluginAPI::QGCPluginAPI)
#
# See ../../SDK-README.md (installed at the package root) for the full
# compatibility contract.

# Resolve every packaged path before find_dependency(): Qt6's own package config runs
# configure_package_config_file's PACKAGE_INIT and reassigns PACKAGE_PREFIX_DIR, so a path
# computed after it points into the Qt prefix.
set_and_check(QGCPluginAPI_QML_IMPORT_PATH "@PACKAGE_QGC_PLUGIN_API_QML_DIR@")
set_and_check(QGC_PLUGIN_API_HEADER_DIR "@PACKAGE_QGC_PLUGIN_API_INCLUDE_DIR@")

include(CMakeFindDependencyMacro)
find_dependency(Qt6 @QGC_QT_MINIMUM_VERSION@ COMPONENTS Core)

include("${CMAKE_CURRENT_LIST_DIR}/QGCPluginAPITargets.cmake")

# QML import path for the published QGroundControl.PluginUI module — the vocabulary
# a plugin's QML may use. Pass it to qmllint (and to nothing else: the host engine
# provides the implementations at runtime, so there is nothing here to link or
# deploy):
#
#   qmllint --import error --missing-property error --unresolved-type error \
#           -I "${QGCPluginAPI_QML_IMPORT_PATH}" MyPanel.qml
#
# Those severity flags are not optional. qmllint diagnoses an unresolved type and
# still exits 0 by default, so a check that omits them reports problems and passes.

# Host identity the standalone arm of a dual-mode plugin's CMakeLists.txt needs to
# derive its own POST_BUILD deploy dir (cmake/modules/PluginHelpers.cmake) —
# one source of truth, so a rebrand of the host doesn't leave a plugin deploying to a
# stale path.
set(QGCPluginAPI_APP_NAME "@QGC_APP_NAME@")
set(QGCPluginAPI_ORG_NAME "@QGC_ORG_NAME@")
set(QGCPluginAPI_STABLE_BUILD "@QGC_STABLE_BUILD@")

# What built this SDK: the full Qt version, and the key a package of a plugin built against
# it goes under (bin/<key>/ in a .qgcplugin).
set(QGCPluginAPI_QT_VERSION "@QGC_PLUGIN_API_QT_VERSION@")
set(QGCPluginAPI_PLATFORM_KEY "@QGC_PLUGIN_API_PLATFORM_KEY@")

# An Android SDK also records the lowest API level and the NDK major it needs, and refuses a
# configure that differs. ANDROID_PLATFORM_LEVEL is the number the NDK toolchain resolves from
# ANDROID_PLATFORM, whether that is "android-30" or a bare "30". CMAKE_ANDROID_NDK_VERSION is
# "<major>.<minor>".
set(QGCPluginAPI_ANDROID_MIN_SDK "@QGC_PLUGIN_API_ANDROID_MIN_SDK@")
set(QGCPluginAPI_ANDROID_NDK_MAJOR "@QGC_PLUGIN_API_ANDROID_NDK_MAJOR@")
if(QGCPluginAPI_PLATFORM_KEY MATCHES "^android-")
    if(ANDROID_PLATFORM_LEVEL AND QGCPluginAPI_ANDROID_MIN_SDK
       AND ANDROID_PLATFORM_LEVEL GREATER QGCPluginAPI_ANDROID_MIN_SDK)
        message(FATAL_ERROR
            "QGCPluginAPI: this plugin targets Android API ${ANDROID_PLATFORM_LEVEL}, above the minimum "
            "API ${QGCPluginAPI_ANDROID_MIN_SDK} that QGroundControl supports. A device on a lower API "
            "can lack a libc symbol the plugin calls. Configure with -DANDROID_PLATFORM=android-"
            "${QGCPluginAPI_ANDROID_MIN_SDK}.")
    endif()
    string(REGEX MATCH "^[0-9]+" _qgc_plugin_ndk_major "${CMAKE_ANDROID_NDK_VERSION}")
    if(QGCPluginAPI_ANDROID_NDK_MAJOR AND NOT _qgc_plugin_ndk_major)
        # A configure without the Android NDK toolchain reports no NDK version. It fails here rather
        # than later, because such a build cannot produce a plugin that loads in QGroundControl.
        message(FATAL_ERROR
            "QGCPluginAPI: CMake did not detect an Android NDK version. Configure with Qt's Android "
            "toolchain file (lib/cmake/Qt6/qt.toolchain.cmake in the Android kit) and set ANDROID_NDK_ROOT "
            "to NDK ${QGCPluginAPI_ANDROID_NDK_MAJOR}, the NDK this SDK was built with.")
    endif()
    if(QGCPluginAPI_ANDROID_NDK_MAJOR AND NOT _qgc_plugin_ndk_major STREQUAL QGCPluginAPI_ANDROID_NDK_MAJOR)
        message(FATAL_ERROR
            "QGCPluginAPI: this plugin builds with NDK ${CMAKE_ANDROID_NDK_VERSION}, but this SDK was built "
            "with NDK ${QGCPluginAPI_ANDROID_NDK_MAJOR}. The plugin's libc++_shared.so must come from the same "
            "NDK major as QGroundControl's, or it can fail to load. Set ANDROID_NDK_ROOT to an NDK "
            "${QGCPluginAPI_ANDROID_NDK_MAJOR} folder.")
    endif()
endif()

# The build-marker generator, shipped as the function rather than as its inputs
# (plugin-enable-disable-correctness U1b) — a plugin's standalone arm calls
#
#   qgc_plugin_build_marker(MyPlugin OUT_SOURCE MARKER MANIFEST ... SOURCES ...)
#
# and adds ${MARKER} to its target, getting the identical marker the in-tree
# dev-loop helper generates. Only the SDK header location differs per arm, and
# this config file is the half that knows its own prefix.
include("${CMAKE_CURRENT_LIST_DIR}/QGCPluginBuildMarker.cmake")

check_required_components(QGCPluginAPI)
