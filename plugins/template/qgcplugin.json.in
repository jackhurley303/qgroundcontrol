{
    "id": "com.example.myplugin",
    "name": "My Plugin",
    "version": "1.0.0",
    "vendor": "Your Name or Organization",
    "description": "A QGroundControl Tier B (SDK) plugin",
    "tier": "sdk",
    "apiVersion": @QGCPluginAPI_VERSION_MAJOR@,
    "hostVersion": { "min": "5.0", "max": "" },
    "hostBuildId": null,
    "contributes": {
        "flyViewPanel": {
            "panel": "qrc:/qml/TemplatePanel.qml",
            "defaultWidth": 35,
            "defaultHeight": 18,
            "defaultPosition": [0.0, 0.0]
        }
    }
}
