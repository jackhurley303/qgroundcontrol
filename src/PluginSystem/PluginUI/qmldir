# ---------------------------------------------------------------------------
# Frozen tier — singletons. Sizing and fonts; theming is the C++ QGCPalette.
# ---------------------------------------------------------------------------
singleton ScreenTools 1.0 ../Controls/ScreenTools.qml

# ---------------------------------------------------------------------------
# Unstable tier — map and mission visuals. Published for lint-time
# resolvability only; freezing a core controller's QML surface is not a
# commitment the host can credibly keep.
# ---------------------------------------------------------------------------
